# Crossmint SERVER-side API key (sk_staging_... o sk_production_...)
# Obtener desde: https://staging.crossmint.com/console/projects/apiKeys
CROSSMINT_SERVER_API_KEY=sk_staging_REPLACE_ME

# Secreto del "server signer" que firma las wallets (formato xmsk1_<64 hex>).
# Generarlo con:  node -e "console.log('xmsk1_'+require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde, las wallets ya creadas no se pueden volver a firmar.
CROSSMINT_SIGNER_SECRET=xmsk1_REPLACE_ME

# URL base de la API de Crossmint
CROSSMINT_BASE_URL=https://staging.crossmint.com/api/2025-06-09

# ID del contrato Soroban desplegado
STELLAR_CONTRACT_ID=CB36FLNBESA7WJIQTJMVKUAE63IAGZ75Q65XER4MD4MF5VCAAO4RGMLE

# Puerto del backend
PORT=3001
